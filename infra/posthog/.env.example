# PostHog provisioning env — copy to infra/posthog/.env and fill in.
# Used by provision.mjs to create flags + dashboards. Works for LOCAL or PROD:
# just change the host + keys. NEVER commit the real .env (it's gitignored).

# Local:  http://localhost:8000     Prod cloud: https://us.i.posthog.com (or eu)
POSTHOG_HOST=http://localhost:8000

# In the URL after /project/ — e.g. .../project/1/... → 1
POSTHOG_PROJECT_ID=1

# Settings → Personal API keys. Scopes: feature_flag:write, dashboard:write,
# insight:write. This is a PERSONAL key (phx_…), NOT the project ingestion key.
POSTHOG_PERSONAL_API_KEY=

# ── For the app (apps/mobile/.env.local), separate from provisioning ──
# EXPO_PUBLIC_POSTHOG_KEY=phc_...        # project ingestion key (Settings → Project)
# EXPO_PUBLIC_POSTHOG_HOST=http://localhost:8000
