.claude/settings.local.json
.DS_Store

# dependencies
node_modules/

# build output
dist/
build/
*.tsbuildinfo

# turbo
.turbo/

# env — names are documented in .env.example; values never land in git
.env
.env.*
*.env
!.env.example

# expo
.expo/
apps/mobile/ios/
apps/mobile/android/
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# supabase local
supabase/.branches/
supabase/.temp/

# test / coverage
coverage/

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# store credentials — never commit
# FCM service account for Android push; referenced by GOOGLE_SERVICES_JSON.
google-services.json
GoogleService-Info.plist
# Play signing / service-account JSONs used by EAS submit.
*-play-service-account.json

# Google Cloud service account keys — NEVER commit (contains a private key)
/aura-*.json
*service-account*.json
*serviceaccount*.json
# Firebase Admin SDK / FCM V1 service-account keys (downloaded from Firebase
# console for EAS push). The name has no "service-account" substring and can be
# saved in any dir, so match it explicitly — a private key must never be commit.
*firebase-adminsdk*.json

# Google OAuth client secret JSONs (downloaded from Cloud Console) — NEVER commit
client_secret*.json
# Signing / deployment certificates
*.der

# Stray credential notes. `textingAccount.tet` held a Play Store reviewer login
# in plaintext and was tracked — the patterns above all missed it because of the
# extension. Match by INTENT as well as by file type.
*reviewer*account*
*credentials*.txt
*password*.txt
*.tet
